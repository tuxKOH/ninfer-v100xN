# syntax=docker/dockerfile:1
# Build from the qualified release package, without recompiling a different binary.
FROM ubuntu:24.04 AS base

ARG DEBIAN_FRONTEND=noninteractive
ARG VERSION=0.2.1
RUN apt-get update && apt-get install --yes --no-install-recommends \
        ca-certificates curl python3 python3-venv tini ncurses-term \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir huggingface-hub==1.0.1

# The build context is the extracted Linux SM70 release package.
FROM base AS release
ARG VERSION=0.2.1
WORKDIR /opt/ninfer
COPY . .
RUN ln -s /opt/ninfer/bin/ninfer /usr/local/bin/ninfer \
    && ln -s /opt/ninfer/bin/ninfer-serve /usr/local/bin/ninfer-serve

LABEL org.opencontainers.image.title="NInfer V100" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://github.com/tuxKOH/ninfer-v100xN" \
      org.opencontainers.image.licenses="Apache-2.0"

ENV PATH="/opt/venv/bin:/opt/ninfer/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    LANG=C.UTF-8 \
    TERM=xterm-256color \
    NINFER_MODEL_DIR=/Models/ninfer-V100X2 \
    HF_HOME=/Models/ninfer-V100X2/.huggingface \
    XDG_CONFIG_HOME=/data/config \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

VOLUME ["/Models/ninfer-V100X2", "/data"]
EXPOSE 8080
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/opt/venv/bin/python3", "/opt/ninfer/docker/entrypoint.py"]
CMD []
